{
  "name": "@minimart/module-inventory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public/index.d.ts",
      "default": "./dist/public/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=1 --fileParallelism=false"
  },
  "minimart": {
    "layer": "domain",
    "module": "inventory",
    "capabilities": [
      "inventory-public"
    ]
  },
  "dependencies": {
    "@minimart/shared-kernel": "workspace:*"
  },
  "devDependencies": {
    "@minimart/test-support": "workspace:*",
    "vitest": "^3.2.4"
  }
}
