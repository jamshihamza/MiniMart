{
  "name": "@minimart/module-cash-business-day",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public/index.d.ts",
      "default": "./dist/public/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false"
  },
  "minimart": {
    "layer": "domain",
    "module": "cash-business-day",
    "capabilities": [
      "cash-business-day-public"
    ]
  }
}
