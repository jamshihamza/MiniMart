{
  "name": "@minimart/service-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@minimart/database": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "minimart": {
    "layer": "application",
    "module": "system",
    "capabilities": [
      "service-runtime"
    ]
  }
}
