{
  "name": "@minimart/application-coordinators",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=1 --fileParallelism=false"
  },
  "minimart": {
    "layer": "application",
    "module": "cross-module",
    "capabilities": [
      "posting-coordination"
    ]
  },
  "dependencies": {
    "@minimart/shared-kernel": "workspace:*",
    "@minimart/module-organization": "workspace:*",
    "@minimart/module-iam": "workspace:*",
    "@minimart/module-catalog": "workspace:*",
    "@minimart/module-pricing": "workspace:*",
    "@minimart/module-inventory": "workspace:*",
    "@minimart/module-sales": "workspace:*",
    "@minimart/module-payments": "workspace:*",
    "@minimart/module-cash-business-day": "workspace:*"
  },
  "devDependencies": {
    "@minimart/test-support": "workspace:*",
    "vitest": "^3.2.4"
  }
}
