{
  "name": "@minimart/test-support",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false"
  },
  "minimart": {
    "layer": "test",
    "module": "test-support",
    "capabilities": [
      "test-support"
    ]
  },
  "dependencies": {
    "@minimart/database": "workspace:*",
    "@minimart/shared-kernel": "workspace:*",
    "pg": "^8.16.3",
    "@testcontainers/postgresql": "^11.8.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
