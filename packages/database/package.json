{
  "name": "@minimart/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=1 --fileParallelism=false"
  },
  "dependencies": {
    "kysely": "^0.28.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.8.0",
    "@types/pg": "^8.15.5",
    "vitest": "^3.2.4"
  },
  "minimart": {
    "layer": "infrastructure",
    "module": "database",
    "capabilities": [
      "database-runtime"
    ]
  }
}
