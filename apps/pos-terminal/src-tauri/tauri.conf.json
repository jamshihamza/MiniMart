{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniMart POS",
  "version": "0.0.0",
  "identifier": "com.minimart.pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiniMart POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true
      }
    ]
  }
}
