  "decisions": [
    {
      "id": "DEC-RPT-001",
      "status": "OPEN",
      "text": "Historical versus current master grouping, decided per report.",
      "affects": "Sales by Category; grouping screens"
    },
    {
      "id": "DEC-RPT-002",
      "status": "PROPOSED",
      "text": "The Phase-2 baseline report list is the one in the Reporting FRS. The design follows that list; it is not frozen.",
      "affects": "Reports Home"
    },
    {
      "id": "FR-RPT-050 / 016",
      "status": "OPEN",
      "text": "Definitions of gross sales, discounts, returns, net sales and tax for reports. FR-RPT-016 requires \"approved\" definitions that no document states.",
      "affects": "Every sales report; definitions screen"
    },
    {
      "id": "FR-RPT-044",
      "status": "OPEN",
      "text": "Approved aging buckets and the due-date basis (with DEC-CRD-002).",
      "affects": "Customer Aging Report"
    },
    {
      "id": "DEC-INV-007",
      "status": "OPEN",
      "text": "Who owns the reorder or low-stock threshold.",
      "affects": "Low Stock Report"
    },
    {
      "id": "DEC-INV-004 / 005",
      "status": "OPEN",
      "text": "Batch selection and expiry/FEFO policy; DEC-POS-003 expiry-sale policy is VERIFY.",
      "affects": "Batch / Expiry Report"
    },
    {
      "id": "DEC-INV-003",
      "status": "OPEN",
      "text": "Stock-count concurrency policy.",
      "affects": "Stock Count Variance Report"
    },
    {
      "id": "DEC-RET-001",
      "status": "OPEN",
      "text": "Whether no-receipt returns exist and under what eligibility.",
      "affects": "No-Receipt Return Report"
    },
    {
      "id": "DEC-CRD-001 / 002 / 003 / 004",
      "status": "OPEN",
      "text": "Credit limit, collection allocation, customer advance and suspended-credit override policies.",
      "affects": "Credit reports"
    },
    {
      "id": "DEC-CSH-001..005, DEC-COM-001",
      "status": "OPEN",
      "text": "Business-date rollover, day close, late transactions, reopen and active-shift policies.",
      "affects": "Cash and day close reports; date filters"
    },
    {
      "id": "DEC-PAY-001",
      "status": "PROPOSED",
      "text": "Card and QR adapter baseline behaviour.",
      "affects": "Tender and Payment Exception reports"
    },
    {
      "id": "DEC-CUS-002",
      "status": "VERIFY",
      "text": "Customer retention and anonymisation period.",
      "affects": "Customer data screens"
    },
    {
      "id": "DEC-PUR-001 / 002 / 006",
      "status": "PROPOSED",
      "text": "Purchase-order and direct-GRN policy. Tax recoverability is VERIFY.",
      "affects": "Purchasing reports"
    },
    {
      "id": "DEC-INV-001",
      "status": "RESOLVED",
      "text": "Moving weighted-average cost per Item per Store. Used for inventory valuation.",
      "affects": "Inventory Valuation Report"
    },
    {
      "id": "DEC-INV-010",
      "status": "RESOLVED",
      "text": "Phase-1 negative-stock default is BLOCK.",
      "affects": "Negative Stock Report"
    }
  ],
  "gaps": [
    {
      "gap": "Report codes, name keys, filter field codes and operators are not frozen",
      "detail": "ReportDefinition and ReportRunRequest define only the shapes. The design uses human labels."
    },
    {
      "gap": "No frozen screen owns Cash/Shift/Day-close reports or the Management Daily Summary",
      "detail": "UI-RPT-001..005 cover sales/tender, inventory, purchasing/payables and credit/collections. The cash and management reports in FR-RPT-027..030 and 047..049 have no named screen."
    },
    {
      "gap": "Permissions beyond reporting.read and reporting.write are not defined",
      "detail": "Needed for cost-sensitive access, source drill-down, unmasking customer data, sensitive export and per-cashier visibility."
    },
    {
      "gap": "Hand-off from a report to Export Center is not described",
      "detail": "UI-EXP-001 lists import and export operations only. The \"Continue in Export Center\" link is a design proposal."
    },
    {
      "gap": "Page limits differ between contracts",
      "detail": "ReportRunRequest.limit allows 1–500 while PageInfo.limit allows at most 200."
    },
    {
      "gap": "No central or multi-branch report screen exists (Phase 3)",
      "detail": "UI-CLD-001..003 are cloud screens; FR-RPT-054/055 have no frozen screen."
    },
    {
      "gap": "Print channel, page size and orientation are undefined",
      "detail": "FR-RPT-056 says \"readable form\" only."
    },
    {
      "gap": "Audit policy for report access and export is undefined",
      "detail": "FR-RPT-061 is a SHOULD \"according to policy\"."
    },
    {
      "gap": "Export artifact retention is a policy seam",
      "detail": "API 16-IMPORT-EXPORT-JOB-ARTIFACT."
    },
    {
      "gap": "Performance targets and the acceptance suite are not visual",
      "detail": "FR-RPT-063 and FR-RPT-065 need data volumes and tests, not screens."
    }
  ],
